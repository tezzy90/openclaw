# =============================================================================
# OpenClaw Production Environment
# =============================================================================
#
# 1. Copy this file:  cp .env.production.example .env
# 2. Fill in your values below
# 3. Never commit .env to git
#
# Required fields are marked [REQUIRED]. Everything else is optional.
# =============================================================================

# -----------------------------------------------------------------------------
# GATEWAY AUTH [REQUIRED]
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# Gateway networking
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan

# Docker image name (leave as default to always get latest official release)
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# -----------------------------------------------------------------------------
# LLM PROVIDERS - set at least one [REQUIRED]
# -----------------------------------------------------------------------------
# You need at least one provider for the agent to think.
#
# IMPORTANT (as of April 4, 2026):
# Claude Pro/Max subscriptions CANNOT be used with OpenClaw. Anthropic's updated
# TOS prohibits using subscription OAuth tokens in third-party tools. You must
# use a separate Anthropic API key (pay-as-you-go via Claude Console) if you
# want Claude models in OpenClaw.
#
# Recommended budget-friendly setup:
#   - DeepSeek API (primary reasoning) - ~$5-15/mo
#   - Ollama + Gemma local (simple tasks) - free
#   - Anthropic API key (only when needed) - pay per use

# DeepSeek (RECOMMENDED - cheap, strong reasoning, ~$0.28/M tokens)
# Get key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Anthropic Claude (pay-as-you-go API key, NOT your Max subscription)
# Get key at: https://console.anthropic.com
# Pricing: ~$3/M input, $15/M output for Sonnet
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini (cheap + capable)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (access to many models via one key, includes free tier models)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local Ollama (runs on your Mac Studio - free)
# If Ollama runs on the same machine as Docker, use host.docker.internal
# If Ollama runs on another machine, use that machine's IP
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# MESSAGING CHANNELS - set the ones you want to use
# -----------------------------------------------------------------------------

# Slack (recommended for your setup)
# Create a Slack app: https://api.slack.com/apps
# Required scopes: chat:write, app_mentions:read, channels:history, im:history
# Socket Mode must be enabled for SLACK_APP_TOKEN
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Telegram
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Discord
# Create at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# -----------------------------------------------------------------------------
# TOOLS (optional, enhance agent capabilities)
# -----------------------------------------------------------------------------

# Brave Search API (for web_search tool)
# Get free key at: https://brave.com/search/api/
BRAVE_API_KEY=

# Firecrawl (advanced web scraping)
# FIRECRAWL_API_KEY=

# Perplexity (AI-powered search)
# PERPLEXITY_API_KEY=

# -----------------------------------------------------------------------------
# BROWSER SANDBOX (optional, for visual debugging)
# -----------------------------------------------------------------------------
# Only needed if you enable the browser profile:
#   docker compose -f docker-compose.prod.yml --profile browser up -d
OPENCLAW_BROWSER_CDP_PORT=9222
OPENCLAW_BROWSER_NOVNC_PORT=6080
